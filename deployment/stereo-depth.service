[Unit]
Description=Stereo Studio - stereo cameras and depth map
After=network.target

[Service]
Type=simple
User=toto
WorkingDirectory=/home/toto/stereo-depth
ExecStart=/usr/bin/python3 /home/toto/stereo-depth/app.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=3

[Install]
WantedBy=multi-user.target
